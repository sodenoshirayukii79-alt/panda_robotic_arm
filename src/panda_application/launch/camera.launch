<?xml version="1.0"?>
<launch>
  <arg name="x" default="0.45"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="1.20"/>

  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_panda_camera"
        args="-sdf
              -file $(find panda_application)/models/panda_camera.sdf
              -model panda_camera
              -x $(arg x)
              -y $(arg y)
              -z $(arg z)"
        output="screen"/>
</launch>