<?xml version="1.0"?>
<sdf version="1.6">
  <model name="target_cube">
    <static>false</static>

    <link name="cube_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000208333</ixx>
          <iyy>0.0000208333</iyy>
          <izz>0.0000208333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="cube_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>0</max_vel>
              <min_depth>0.003</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.13</mu>
              <mu2>1.13</mu2>
            </ode>
          </friction>
          <bounce/>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
