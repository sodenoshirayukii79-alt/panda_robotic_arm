<?xml version="1.0"?>
<launch>
  <node pkg="panda_vision"
        type="pixel_to_world.py"
        name="pixel_to_world"
        output="screen">

    <param name="camera_x" value="0.45"/>
    <param name="camera_y" value="0.0"/>
    <param name="camera_z" value="1.20"/>
    <param name="target_plane_z" value="0.025"/>

  </node>
</launch>
